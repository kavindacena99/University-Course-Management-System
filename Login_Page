                          onChange={(e) => setPassword(e.target.value)}
                          placeholder="Enter your password"
                          className="w-full h-[38px] pl-3.5 pr-9 rounded-[10px] bg-[#f1f1f1] text-[12px] text-[#23253a] placeholder:text-[#b4b4b4] shadow-[0_2px_3px_rgba(0,0,0,0.12)] border border-transparent focus:border-[#276486]/40 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#276486]/15 transition-all"
                        />
                        {password.length > 0 && (
                          <button
                            type="button"
                            onClick={() => setShowPassword((prev) => !prev)}
                            className="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-[#276486] p-1 transition-colors"
                            aria-label={showPassword ? 'Hide password' : 'Show password'}
                          >
                            {showPassword ? (
                              <EyeOff className="w-3.5 h-3.5" />
                            ) : (
                              <Eye className="w-3.5 h-3.5" />
                            )}
                          </button>
                        )}
                      </div>
                    </div>
                  </div>

                  {/* Remember Me & Forgot Password Row */}
                  <div className="flex items-center justify-between pl-9 pt-0.5 text-[10.5px]">
                    <label className="inline-flex items-center gap-2 cursor-pointer select-none text-[#23253a] font-semibold">
                      <input
                        type="checkbox"
                        checked={rememberMe}
                        onChange={(e) => setRememberMe(e.target.checked)}
                        className="w-3.5 h-3.5 rounded-[3px] border border-[#23253a] accent-[#276486] cursor-pointer"
                      />
                      <span>Remember me</span>
                    </label>

                    <button
                      type="button"
                      onClick={() => handleModeSwitch('forgot')}
                      className="italic font-bold text-[#23253a] hover:text-[#276486] transition-colors cursor-pointer"
                    >
                      Forgot Password?
                    </button>
                  </div>

                  {/* Primary & Secondary Action Buttons */}
                  <div className="pl-6 pt-3 space-y-2.5">
                    <button
                      type="submit"
                      disabled={isLoading}
                      className="w-full h-[36px] rounded-[9px] bg-[#276486] hover:bg-[#1f526e] active:scale-[0.99] disabled:opacity-60 text-white text-[12px] font-semibold shadow-sm transition-all cursor-pointer flex items-center justify-center"
                    >
                      {isLoading ? 'Signing In...' : 'Sign In'}
                    </button>

                    <button
                      type="button"
                      onClick={handleGoogleSignIn}
                      disabled={isLoading}
                      className="w-full h-[36px] rounded-[9px] bg-[#e2e2e2] hover:bg-[#d6d6d6] active:scale-[0.99] disabled:opacity-60 text-[#23253a] text-[12px] font-semibold transition-all cursor-pointer flex items-center justify-center gap-2"
                    >
                      <GoogleLogo />
                      <span>Sign In with Google</span>
                    </button>
                  </div>
                </form>

                {/* Footer Sign Up Link */}
                <p className="mt-7 pl-6 text-center text-[11px] text-slate-500">
                  Don&apos;t have an account?{' '}
                  <button
                    type="button"
                    onClick={() => handleModeSwitch('signup')}
                    className="font-bold text-[#23253a] hover:text-[#276486] transition-colors cursor-pointer"
                  >
                    Sign up
                  </button>
                </p>
              </>
            )}

            {/* SIGN UP VIEW */}
            {authMode === 'signup' && (
              <>
                <div className="text-center mb-5">
                  <h2 className="text-[24px] sm:text-[27px] font-extrabold tracking-wide text-[#256689] uppercase">
                    CREATE ACCOUNT
                  </h2>
                  <p className="mt-1 text-[11.5px] text-slate-600 font-medium">
                    Register with your university credentials to get started
                  </p>
                </div>

                {errorMsg && (
                  <div
                    role="alert"
                    className="mb-4 px-3.5 py-2.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-center gap-2"
                  >
                    <AlertCircle className="w-4 h-4 shrink-0" />
                    <span>{errorMsg}</span>
                  </div>
                )}

                <form onSubmit={handleSubmit} noValidate className="space-y-3.5">
                  <div>
                    <label
                      htmlFor="signup-username"
                      className="block text-[11px] font-bold text-[#23253a] mb-1 pl-9"
                    >
                      User Name
                    </label>
                    <div className="flex items-center gap-3">
                      <div className="w-6 flex items-center justify-center shrink-0">
                        <DualUserIcon />
                      </div>
                      <input
                        id="signup-username"
                        type="text"
                        value={username}
                        onChange={(e) => setUsername(e.target.value)}
                        placeholder="Choose a user name"
                        className="w-full h-[38px] px-3.5 rounded-[10px] bg-[#f1f1f1] text-[12px] text-[#23253a] placeholder:text-[#b4b4b4] shadow-[0_2px_3px_rgba(0,0,0,0.12)] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#276486]/20 transition-all"
                      />
                    </div>
                  </div>

                  <div>
                    <label
                      htmlFor="signup-password"
                      className="block text-[11px] font-bold text-[#23253a] mb-1 pl-9"
                    >
                      Password
                    </label>
                    <div className="flex items-center gap-3">
                      <div className="w-6 flex items-center justify-center shrink-0">
                        <PasswordLockIcon />
                      </div>
                      <div className="relative flex-1">
                        <input
                          id="signup-password"
                          type={showPassword ? 'text' : 'password'}
                          value={password}
                          onChange={(e) => setPassword(e.target.value)}
                          placeholder="Create a password (min 6 chars)"
                          className="w-full h-[38px] pl-3.5 pr-9 rounded-[10px] bg-[#f1f1f1] text-[12px] text-[#23253a] placeholder:text-[#b4b4b4] shadow-[0_2px_3px_rgba(0,0,0,0.12)] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#276486]/20 transition-all"
                        />
                        {password.length > 0 && (
                          <button
                            type="button"
                            onClick={() => setShowPassword((prev) => !prev)}
                            className="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-[#276486] p-1"
                            aria-label={showPassword ? 'Hide password' : 'Show password'}
                          >
                            {showPassword ? (
                              <EyeOff className="w-3.5 h-3.5" />
                            ) : (
                              <Eye className="w-3.5 h-3.5" />
                            )}
                          </button>
                        )}
                      </div>
                    </div>
                  </div>

                  <div className="pl-6 pt-3 space-y-2.5">
                    <button
                      type="submit"
                      disabled={isLoading}
                      className="w-full h-[36px] rounded-[9px] bg-[#276486] hover:bg-[#1f526e] text-white text-[12px] font-semibold shadow-sm transition-all cursor-pointer"
                    >
                      {isLoading ? 'Creating Account...' : 'Create Account'}
                    </button>
                  </div>
                </form>

                <p className="mt-6 pl-6 text-center text-[11px] text-slate-500">
                  Already have an account?{' '}
                  <button
                    type="button"
                    onClick={() => handleModeSwitch('login')}
                    className="font-bold text-[#23253a] hover:text-[#276486] transition-colors cursor-pointer"
                  >
                    Sign in
                  </button>
                </p>
              </>
            )}

            {/* FORGOT PASSWORD VIEW */}
            {authMode === 'forgot' && (
              <>
                <div className="text-center mb-5">
                  <h2 className="text-[23px] sm:text-[25px] font-extrabold tracking-wide text-[#256689] uppercase">
                    RESET PASSWORD
                  </h2>
                  <p className="mt-1 text-[11.5px] text-slate-600 font-medium">
                    Enter your User Name or university email to receive a reset link
                  </p>
                </div>

                {errorMsg && (
                  <div
                    role="alert"
                    className="mb-4 px-3.5 py-2.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-center gap-2"
                  >
                    <AlertCircle className="w-4 h-4 shrink-0" />
                    <span>{errorMsg}</span>
                  </div>
                )}

                <form onSubmit={handleSubmit} noValidate className="space-y-4">
                  <div>
                    <label
                      htmlFor="recovery-input"
                      className="block text-[11px] font-bold text-[#23253a] mb-1.5 pl-9"
                    >
                      User Name or Email
                    </label>
                    <div className="flex items-center gap-3">
                      <div className="w-6 flex items-center justify-center shrink-0">
                        <DualUserIcon />
                      </div>
                      <input
                        id="recovery-input"
                        type="text"
                        value={email}
                        onChange={(e) => setEmail(e.target.value)}
                        placeholder="e.g., student@university.edu"
                        className="w-full h-[38px] px-3.5 rounded-[10px] bg-[#f1f1f1] text-[12px] text-[#23253a] placeholder:text-[#b4b4b4] shadow-[0_2px_3px_rgba(0,0,0,0.12)] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#276486]/20 transition-all"
                      />
                    </div>
                  </div>

                  <div className="pl-6 pt-2 space-y-2.5">
                    <button
                      type="submit"
                      disabled={isLoading}
                      className="w-full h-[36px] rounded-[9px] bg-[#276486] hover:bg-[#1f526e] text-white text-[12px] font-semibold shadow-sm transition-all cursor-pointer"
                    >
                      {isLoading ? 'Sending Link...' : 'Send Recovery Link'}
                    </button>

                    <button
                      type="button"
                      onClick={() => handleModeSwitch('login')}
                      className="w-full h-[36px] rounded-[9px] bg-[#e2e2e2] hover:bg-[#d6d6d6] text-[#23253a] text-[12px] font-semibold transition-all cursor-pointer flex items-center justify-center gap-1.5"
                    >
                      <ArrowLeft className="w-3.5 h-3.5" />
                      <span>Back to Sign In</span>
                    </button>
                  </div>
                </form>
              </>
            )}
          </section>
        </div>
      </main>
    </div>
  );
}
