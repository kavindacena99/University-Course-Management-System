export default function App() {
  // Navigation view state: 'login' | 'signup' | 'forgot'
  const [authMode, setAuthMode] = useState('login');

  // Form inputs state
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [email, setEmail] = useState('');
  const [rememberMe, setRememberMe] = useState(false);
  const [showPassword, setShowPassword] = useState(false);

  // UI feedback states
  const [isLoading, setIsLoading] = useState(false);
  const [errorMsg, setErrorMsg] = useState('');
  const [toastNotification, setToastNotification] = useState(null);

  const triggerToast = (title, message, type = 'success') => {
    setToastNotification({ title, message, type });
    setTimeout(() => {
      setToastNotification(null);
    }, 4500);
  };

  const handleModeSwitch = (mode) => {
    setAuthMode(mode);
    setErrorMsg('');
    setShowPassword(false);
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    setErrorMsg('');

    if (authMode === 'forgot') {
      if (!email.trim()) {
        setErrorMsg('Please enter your university email or user name.');
        return;
      }
      setIsLoading(true);
      setTimeout(() => {
        setIsLoading(false);
        triggerToast(
          'Reset Link Sent',
          `Password recovery instructions have been dispatched to ${email.trim()}.`
        );
        setEmail('');
        setAuthMode('login');
      }, 750);
      return;
    }

    if (!username.trim()) {
      setErrorMsg('Please enter your User Name.');
      return;
    }
    if (!password.trim()) {
      setErrorMsg('Please enter your Password.');
      return;
    }
    if (authMode === 'signup' && password.length < 6) {
      setErrorMsg('Password must be at least 6 characters long.');
      return;
    }

    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      if (authMode === 'login') {
        triggerToast(
          `Welcome back, ${username.trim()}!`,
          rememberMe
            ? 'Signed in to University Course Management System (Session remembered).'
            : 'Signed in to University Course Management System.'
        );
      } else {
        triggerToast(
          'Account Created!',
          `Your student/faculty account "${username.trim()}" is ready. You can now sign in.`
        );
        setAuthMode('login');
      }
    }, 800);
  };

  const handleGoogleSignIn = () => {
    setErrorMsg('');
    setIsLoading(true);
    setTimeout(() => {
      setIsLoading(false);
      triggerToast(
        'Google SSO Connected',
        'Authenticated via University Google Workspace account.'
      );
    }, 700);
  };

  return (
    <div
      className="min-h-screen w-full flex items-center justify-center p-4 sm:p-6 md:p-10 font-sans antialiased selection:bg-[#276486] selection:text-white relative overflow-x-hidden"
      style={{
        background:
          'linear-gradient(125deg, #7c80d6 0%, #8ea4e6 32%, #76c5f2 68%, #87f0c8 100%)',
      }}
    >
      {/* Subtle Ambient Mesh Glows matching the screenshot's soft gradient transitions */}
      <div
        className="pointer-events-none fixed inset-0 opacity-60"
        style={{
          background:
            'radial-gradient(circle at 15% 20%, rgba(116, 121, 212, 0.55) 0%, transparent 45%), radial-gradient(circle at 88% 85%, rgba(135, 240, 200, 0.65) 0%, transparent 50%)',
        }}
      />

      {/* Interactive Feedback Toast Banner */}
      {toastNotification && (
        <div
          role="status"
          aria-live="polite"
          className="fixed top-5 right-5 z-50 max-w-sm w-[calc(100%-2.5rem)] bg-white/95 backdrop-blur-md border border-[#276486]/20 rounded-2xl shadow-xl p-4 flex items-start gap-3 transition-all duration-300"
        >
          <div className="mt-0.5 text-[#276486] shrink-0">
            <CheckCircle2 className="w-5 h-5" />
          </div>
          <div className="flex-1 min-w-0">
            <p className="text-sm font-bold text-[#23253a]">{toastNotification.title}</p>
            <p className="text-xs text-slate-600 mt-0.5 leading-relaxed">
              {toastNotification.message}
            </p>
          </div>
          <button
            type="button"
            onClick={() => setToastNotification(null)}
            className="text-slate-400 hover:text-slate-600 p-1 rounded-lg transition-colors"
            aria-label="Dismiss notification"
          >
            <X className="w-4 h-4" />
          </button>
        </div>
      )}

      {/* Main Centered Card */}
      <main className="relative z-10 w-full max-w-[960px] bg-[#fcf9f9] rounded-[24px] shadow-[0_22px_60px_rgba(30,45,90,0.16)] px-6 py-8 sm:px-10 sm:py-11 md:px-12 md:py-12 transition-all">
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
          {/* LEFT COLUMN: Branding Header + Custom SVG Illustration */}
          <section className="lg:col-span-6 flex flex-col items-center text-center">
            <h1 className="text-[20px] sm:text-[23px] font-bold tracking-tight text-[#23253a] leading-snug">
              University Course Management System
            </h1>
            <p className="mt-1.5 mb-6 sm:mb-7 text-[13.5px] sm:text-[14.5px] italic font-medium text-[#27698c]">
              Connecting Minds, Shaping Tomorrow
            </p>

            {/* Illustration Card */}
            <UniversityIllustration />
          </section>

          {/* RIGHT COLUMN: Welcome Form */}
          <section className="lg:col-span-6 w-full max-w-[360px] mx-auto flex flex-col justify-center">
            {authMode === 'login' && (
              <>
                <div className="text-center mb-6">
                  <h2 className="text-[26px] sm:text-[29px] font-extrabold tracking-wide text-[#256689] uppercase">
                    WELCOME
                  </h2>
                  <p className="mt-1 text-[11px] sm:text-[11.5px] text-slate-600 font-medium">
                    Enter your User Name and Password to access your account
                  </p>
                </div>

                {errorMsg && (
                  <div
                    role="alert"
                    className="mb-4 px-3.5 py-2.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-center gap-2"
                  >
                    <AlertCircle className="w-4 h-4 shrink-0" />
                    <span>{errorMsg}</span>
                  </div>
                )}

                <form onSubmit={handleSubmit} noValidate className="space-y-4">
                  {/* User Name Field */}
                  <div>
                    <label
                      htmlFor="username-input"
                      className="block text-[11px] font-bold text-[#23253a] mb-1.5 pl-9"
                    >
                      User Name
                    </label>
                    <div className="flex items-center gap-3">
                      <div className="w-6 flex items-center justify-center shrink-0">
                        <DualUserIcon />
                      </div>
                      <div className="relative flex-1">
                        <input
                          id="username-input"
                          type="text"
                          autoComplete="username"
                          value={username}
                          onChange={(e) => setUsername(e.target.value)}
                          placeholder="Enter your user name"
                          className="w-full h-[38px] px-3.5 rounded-[10px] bg-[#f1f1f1] text-[12px] text-[#23253a] placeholder:text-[#b4b4b4] shadow-[0_2px_3px_rgba(0,0,0,0.12)] border border-transparent focus:border-[#276486]/40 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#276486]/15 transition-all"
