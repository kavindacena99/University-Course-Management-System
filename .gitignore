.env
.env.*
!.env.example

bin/
dist/
services/*/var/
.go-cache/

# NGINX host-run runtime files
infrastructure/nginx/logs/*
!infrastructure/nginx/logs/.gitkeep
infrastructure/nginx/temp/

# Local infrastructure credentials, tooling and recovery artifacts
.infra-venv/
.infra-state/
infrastructure/environments/*/runtime/
infrastructure/environments/*/secrets/
infrastructure/ansible/**/vault.yml
!infrastructure/ansible/**/vault.yml.example
*vault-pass*
secrets/
!infrastructure/ansible/roles/secrets/
!infrastructure/ansible/roles/secrets/**
backups/
*.dump
*.sql.gz
*.backup
*.pgdump
*-dump.sql
*-backup.sql
*.sql.bak
*.bak
*.p12
*.pfx
*.key
*.pem
*.log
__pycache__/
