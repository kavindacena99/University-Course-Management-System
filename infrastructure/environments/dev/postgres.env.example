# INACTIVE LOCAL DEV consolidated target; legacy remains the default.
# This template is not sufficient to start applications; initialization creates runtime files.
COMPOSE_PROJECT_NAME=platform-dev-target
FRONTEND_PORT=3000
GATEWAY_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
AUTH_PRIVATE_KEY_FILE=../environments/dev/target-runtime/keys/jwt-private.pem
FRONTEND_CONFIG_FILE=../environments/dev/target-runtime/frontend.conf
GATEWAY_CONFIG_FILE=../environments/dev/target-runtime/gateway.conf
AUTH_ENV_FILE=../environments/dev/target-runtime/auth.env
AUTH_DB_PASSWORD=replace-with-independent-local-secret
USER_ENV_FILE=../environments/dev/target-runtime/user.env
USER_DB_PASSWORD=replace-with-independent-local-secret
COURSE_ENV_FILE=../environments/dev/target-runtime/course.env
COURSE_DB_PASSWORD=replace-with-independent-local-secret
ENROLLMENT_ENV_FILE=../environments/dev/target-runtime/enrollment.env
ENROLLMENT_DB_PASSWORD=replace-with-independent-local-secret
ASSESSMENT_ENV_FILE=../environments/dev/target-runtime/assessment.env
ASSESSMENT_DB_PASSWORD=replace-with-independent-local-secret
ANALYTICS_ENV_FILE=../environments/dev/target-runtime/analytics.env
ANALYTICS_DB_PASSWORD=replace-with-independent-local-secret
MINIO_ROOT_USER=replace-with-local-object-admin
MINIO_ROOT_PASSWORD=replace-with-independent-local-secret
ASSESSMENT_OBJECT_USER=replace-with-local-object-user
ASSESSMENT_OBJECT_PASSWORD=replace-with-independent-local-secret
OBJECT_STORE_IMAGE=pgsty/silo:RELEASE.2026-11-12T00-00-00Z@sha256:c20d112390b9a9ce8c11b8af95ad35bcaa62f4759663c09c936cd8d2b511f329
AUTH_IMAGE=ucm-auth:candidate
USER_IMAGE=ucm-user:candidate
COURSE_IMAGE=ucm-course:candidate
ENROLLMENT_IMAGE=ucm-enrollment:candidate
ASSESSMENT_IMAGE=ucm-assessment:candidate
ANALYTICS_IMAGE=ucm-analytics:candidate
FRONTEND_IMAGE=ucm-frontend:candidate
GATEWAY_IMAGE=ucm-gateway:candidate
ASSESSMENT_MINIO_INIT_IMAGE=ucm-assessment-minio-init:candidate

# PREPARED TARGET ONLY; requires independently generated protected files.
PG_PROJECT=platform-dev-target
TARGET_APP_ENV=development
POSTGRES_IMAGE=ucm-postgres:phase123
PG_ADMIN_PASSWORD_FILE=../environments/dev/target-secrets/admin-password
PG_BOOTSTRAP_SQL_FILE=../environments/dev/target-secrets/bootstrap.sql
PG_MIGRATION_PASSWORD_FILE=../environments/dev/target-secrets/migration.pgpass
AUTH_MIGRATION_DB_PASSWORD=replace-with-independent-migration-secret
USER_MIGRATION_DB_PASSWORD=replace-with-independent-migration-secret
COURSE_MIGRATION_DB_PASSWORD=replace-with-independent-migration-secret
ENROLLMENT_MIGRATION_DB_PASSWORD=replace-with-independent-migration-secret
ASSESSMENT_MIGRATION_DB_PASSWORD=replace-with-independent-migration-secret
ANALYTICS_MIGRATION_DB_PASSWORD=replace-with-independent-migration-secret
