# Development Compose environment.
#
# Copy this file to infrastructure/docker/.env and replace every placeholder.
# The .env file is ignored by Git. Do not commit real credentials.
#
# Service-specific settings remain in services/*/.env; copy each service's
# .env.example to .env before starting the stack.

COMPOSE_PROJECT_NAME=ucm-dev

GATEWAY_PORT=8080
FRONTEND_PORT=3000

# The frontend calls the gateway directly from the browser. Keep this origin
# aligned with the frontend CSP and each service's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

AUTH_DB_PASSWORD=replace-with-a-local-auth-db-password
USER_DB_PASSWORD=replace-with-a-local-user-db-password
COURSE_DB_PASSWORD=replace-with-a-local-course-db-password
ENROLLMENT_DB_PASSWORD=replace-with-a-local-enrollment-db-password
ASSESSMENT_DB_PASSWORD=replace-with-a-local-assessment-db-password
ANALYTICS_DB_PASSWORD=replace-with-a-local-analytics-db-password

MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-root-password

ASSESSMENT_OBJECT_USER=assessment-local
ASSESSMENT_OBJECT_PASSWORD=replace-with-a-local-assessment-object-password
