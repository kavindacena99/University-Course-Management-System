APP_ENV=development
COURSE_SERVICE_PORT=8083
BIND_HOST=127.0.0.1
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=courses
DB_USER=course_app
DB_PASSWORD=change-me
DB_SSLMODE=disable

AUTH_JWT_PUBLIC_KEYS_JSON={"auth-key-1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
AUTH_JWT_ISSUER=university-auth
AUTH_JWT_AUDIENCE=university-api
AUTH_JWT_CLOCK_SKEW=30s

AUTH_COOKIE_ENABLED=true
ACCESS_TOKEN_COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

INTERNAL_SERVICE_ID=course-service
INTERNAL_SERVICE_SECRET=replace-with-a-shared-secret-of-at-least-32-characters
INTERNAL_ALLOWED_CALLERS=enrollment-service
INTERNAL_AUTH_MAX_SKEW=2m
USER_SERVICE_INTERNAL_URL=http://127.0.0.1:8082
USER_SERVICE_TIMEOUT=2s
AUTH_SERVICE_INTERNAL_URL=http://127.0.0.1:8081
AUTH_SERVICE_TIMEOUT=2s

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXIES=127.0.0.1,::1

HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
MAX_REQUEST_BYTES=1048576

TEST_DATABASE_URL=postgres://course_app:change-me@localhost:5432/courses_test?sslmode=disable
