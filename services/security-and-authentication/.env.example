APP_ENV=development
AUTH_SERVICE_PORT=8081
BIND_HOST=127.0.0.1
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=authentication_and_security
DB_USER=auth_app
DB_PASSWORD=change-me
DB_SSLMODE=disable

# Generate with: go run ./cmd/keygen --out-dir ./var/keys
AUTH_JWT_KEY_ID=dev-1
AUTH_JWT_PRIVATE_KEY_FILE=./var/keys/jwt-private.pem
AUTH_JWT_ISSUER=university-auth
AUTH_JWT_AUDIENCE=university-api
AUTH_JWT_CLOCK_SKEW=30s
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_REFRESH_TOKEN_TTL=24h
AUTH_SESSION_ABSOLUTE_TTL=168h

AUTH_TOKEN_DELIVERY=both
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_ACCOUNT_LOCKOUT_DURATION=15m
LOGIN_RATE_LIMIT_PER_MINUTE=10
FORGOT_PASSWORD_RATE_LIMIT_PER_MINUTE=5

NOTIFICATIONS_MODE=file
NOTIFICATIONS_FILE_PATH=./var/notifications.log
PUBLIC_BASE_URL=http://localhost:8080
AUTH_ACTIVATION_TOKEN_TTL=24h
AUTH_PASSWORD_RESET_TOKEN_TTL=30m

# Must match the user service values. Use at least 32 random characters.
INTERNAL_SERVICE_ID=auth-service
INTERNAL_SERVICE_SECRET=change-me-to-a-shared-secret-of-32-plus-chars
INTERNAL_ALLOWED_CALLERS=user-service,course-service
INTERNAL_AUTH_MAX_SKEW=2m
USER_SERVICE_INTERNAL_URL=http://127.0.0.1:8082
USER_ELIGIBILITY_TIMEOUT=2s

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXIES=127.0.0.1,::1

HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
MAX_REQUEST_BYTES=1048576
