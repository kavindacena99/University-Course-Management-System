APP_ENV=development
USER_SERVICE_PORT=8082
BIND_HOST=127.0.0.1
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=users
DB_USER=user_app
DB_PASSWORD=change-me
DB_SSLMODE=disable

# JSON object mapping key IDs to Ed25519 public keys in PEM format.
# Newlines may be escaped as \n. Copy the public key generated by the auth service keygen command.
AUTH_JWT_PUBLIC_KEYS_JSON={"dev-1":"-----BEGIN PUBLIC KEY-----\n<public-key-base64>\n-----END PUBLIC KEY-----\n"}
AUTH_JWT_ISSUER=university-auth
AUTH_JWT_AUDIENCE=university-api
AUTH_JWT_CLOCK_SKEW=30s
AUTH_COOKIE_ENABLED=true
ACCESS_TOKEN_COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Must match the auth service values. Use at least 32 random characters.
INTERNAL_SERVICE_ID=user-service
INTERNAL_SERVICE_SECRET=change-me-to-a-shared-secret-of-32-plus-chars
INTERNAL_ALLOWED_CALLERS=auth-service,course-service,enrollment-service
INTERNAL_AUTH_MAX_SKEW=2m
ADMIN_BOOTSTRAP_TOKEN=change-me-to-a-bootstrap-token-of-32-plus-chars

AUTH_SERVICE_INTERNAL_URL=http://127.0.0.1:8081
AUTH_ELIGIBILITY_TIMEOUT=2s

OUTBOX_POLL_INTERVAL=2s
OUTBOX_HTTP_TIMEOUT=5s
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXIES=127.0.0.1,::1

HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
MAX_REQUEST_BYTES=1048576
REGISTRATION_RATE_LIMIT_PER_MINUTE=30
