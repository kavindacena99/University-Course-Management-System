APP_ENV=development
ASSESSMENT_SERVICE_PORT=8085
BIND_HOST=127.0.0.1
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=assessments
DB_USER=assessment_app
DB_PASSWORD=change-me
DB_SSLMODE=disable

AUTH_JWT_PUBLIC_KEYS_JSON={"auth-key-1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
AUTH_JWT_ISSUER=university-auth
AUTH_JWT_AUDIENCE=university-api
AUTH_JWT_CLOCK_SKEW=30s
AUTH_COOKIE_ENABLED=true
ACCESS_TOKEN_COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

INTERNAL_SERVICE_ID=assessment-service
INTERNAL_SERVICE_SECRET=replace-with-a-shared-secret-of-at-least-32-characters
INTERNAL_SERVICE_SECRET_PREVIOUS=
ENROLLMENT_SERVICE_INTERNAL_URL=http://127.0.0.1:8084
ENROLLMENT_SERVICE_TIMEOUT=2s
ANALYTICS_SERVICE_INTERNAL_URL=

OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=assessment-local
OBJECT_STORAGE_SECRET_KEY=change-this-local-secret
OBJECT_STORAGE_BUCKET=submissions
OBJECT_STORAGE_USE_SSL=false
MAX_UPLOAD_BYTES=20971520

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXIES=127.0.0.1,::1

HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
MAX_REQUEST_BYTES=23068672
